{
  "name": "food-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "local": "node scripts/ensure-local.mjs && node scripts/dev-server.mjs",
    "setup": "node scripts/ensure-local.mjs",
    "build": "next build --turbopack && npm run build:standalone-assets",
    "build:standalone-assets": "cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "npx prisma migrate deploy && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db:prepare": "node scripts/prepare-test-db.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "prisma": "prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@zxing/browser": "^0.2.1",
    "dotenv": "^18.0.9",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
