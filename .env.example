DATABASE_URL="postgresql://foodtracker:foodtracker@127.0.0.1:5433/foodtracker?schema=public"
DATABASE_URL_TEST="postgresql://foodtracker:foodtracker@127.0.0.1:5433/foodtracker_test?schema=public"

# Better Auth (app login + MCP OAuth). Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app (no trailing slash). Local example; use HTTPS Railway URL in prod.
BETTER_AUTH_URL="http://localhost:3000"
# Seeded account password (local/dev only). Required by `npm run db:seed`.
SEED_USER_PASSWORD=
# Optional: stdio MCP resolves this user (defaults to calvin@foodtracker.local)
# FOODTRACKER_USER_EMAIL=

# USDA FoodData Central (catalog search) — https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# Required for Plus → Scan Label (OpenAI gpt-4o-mini vision)
OPENAI_API_KEY=
