generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoodSource {
  open_food_facts
  custom
  barcode
  ocr
  recipe
  usda_fdc
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  displayName   String   @map("display_name")
  timezone      String   @default("America/Los_Angeles")
  calorieGoal   Float?   @map("calorie_goal")
  proteinGoalG  Float?   @map("protein_goal_g")
  carbsGoalG    Float?   @map("carbs_goal_g")
  fatGoalG      Float?   @map("fat_goal_g")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  foods    Food[]
  entries  FoodEntry[]
  favorites Favorite[]

  @@map("users")
}

model Food {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  source         FoodSource
  externalId     String?    @map("external_id")
  barcode        String?
  name           String
  brand          String?
  servingQty     Float      @map("serving_qty")
  servingUnit    String     @map("serving_unit")
  calories       Float      @default(0)
  proteinG       Float      @default(0) @map("protein_g")
  carbsG         Float      @default(0) @map("carbs_g")
  fatG           Float      @default(0) @map("fat_g")
  fiberG         Float      @default(0) @map("fiber_g")
  sugarG         Float      @default(0) @map("sugar_g")
  sodiumMg          Float      @default(0) @map("sodium_mg")
  nutrientsExtra    Json       @default("{}") @map("nutrients_extra")
  sourcePayload     Json?      @map("source_payload")
  servingsPerRecipe Float?     @map("servings_per_recipe")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries             FoodEntry[]
  favorites           Favorite[]
  recipeIngredients   RecipeIngredient[] @relation("RecipeToIngredients")
  usedInRecipes       RecipeIngredient[] @relation("IngredientInRecipes")

  @@unique([source, externalId])
  @@index([userId, source])
  @@index([name])
  @@map("foods")
}

model RecipeIngredient {
  id            String @id @default(uuid()) @db.Uuid
  recipeId      String @map("recipe_id") @db.Uuid
  ingredientId  String @map("ingredient_id") @db.Uuid
  /** Normalized multiplier of the ingredient's defined serving. */
  servings      Float
  quantityValue Float  @map("quantity_value")
  /** "serving", "recipe", or the ingredient's serving unit string. */
  quantityUnit  String @map("quantity_unit")
  position      Int    @default(0)

  recipe     Food @relation("RecipeToIngredients", fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Food @relation("IngredientInRecipes", fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model Favorite {
  userId String @map("user_id") @db.Uuid
  foodId String @map("food_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
  @@map("favorites")
}

model FoodEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  foodId                 String   @map("food_id") @db.Uuid
  loggedOn               DateTime @map("logged_on") @db.Date
  meal                   MealType
  /** Normalized multiplier of the food's defined serving (for nutrient snapshots). */
  servings               Float
  /** Amount the user typed when logging. */
  quantityValue          Float    @map("quantity_value")
  /** "serving" or the food's serving unit string (e.g. "g", "cup"). */
  quantityUnit           String   @map("quantity_unit")
  foodNameSnapshot       String   @map("food_name_snapshot")
  caloriesSnapshot       Float    @map("calories_snapshot")
  proteinGSnapshot       Float    @map("protein_g_snapshot")
  carbsGSnapshot         Float    @map("carbs_g_snapshot")
  fatGSnapshot           Float    @map("fat_g_snapshot")
  fiberGSnapshot         Float    @map("fiber_g_snapshot")
  sugarGSnapshot         Float    @map("sugar_g_snapshot")
  sodiumMgSnapshot       Float    @map("sodium_mg_snapshot")
  nutrientsExtraSnapshot Json     @default("{}") @map("nutrients_extra_snapshot")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([userId, loggedOn])
  @@index([userId, createdAt])
  @@map("food_entries")
}
